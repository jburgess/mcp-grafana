{
  "name": "@jburgess-js/mcp-grafana",
  "version": "0.3.0",
  "description": "Strongly-typed Grafana dashboard & panel builders, a structural lint surface, a semantic dashboard diff, and scaffold/audit/review recipes — over MCP. Targets Grafana 12.x.",
  "keywords": [
    "grafana",
    "mcp",
    "model-context-protocol",
    "dashboard",
    "dashboards-as-code",
    "panel",
    "lint",
    "promql",
    "prometheus",
    "observability-as-code"
  ],
  "license": "MIT",
  "author": "jburgess",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jburgess/mcp-grafana.git"
  },
  "homepage": "https://github.com/jburgess/mcp-grafana",
  "bugs": {
    "url": "https://github.com/jburgess/mcp-grafana/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-grafana": "./dist/mcp/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "docs/guidance",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .vitest-cache *.tsbuildinfo",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@grafana/grafana-foundation-sdk": "0.0.12",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prometheus-io/lezer-promql": "^0.311.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.0",
    "fast-check": "^4.0.0",
    "testcontainers": "^11.14.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
